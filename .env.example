# Carbide2 environment template — copy to .env and edit.

# Rails environment. Leave as development for local use.
RAILS_ENV=development

# DO NOT set DATABASE_URL — the Rails app reads host/user/password/db from the
# per-environment block in config/database.yml, which the operator populates
# from the workspace's CNPG credentials. Setting DATABASE_URL here will
# override that and break the worker's connection.
# DATABASE_URL=postgres://carbide:carbide@postgres:5432/carbide2_development

# Worker token expiry (legacy; only relevant if a local minting path exists).
WORKER_TOKEN_EXPIRY_SECONDS=600

# Optional: OAuth providers (leave blank to disable social login)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
